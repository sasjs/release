# The estate's npm settings, and the ones this repository's callers already run with.
#
# `ignore-scripts` keeps a dependency's install script from running by default: this
# repository is the release and audit tool for the others, so nothing here should
# execute code on install. The publish workflow opts back in with
# `--ignore-scripts=false`, so `prepublishOnly` still refuses to publish a 0.0.0
# version.
#
# `save-exact` writes an exact version rather than a range, which is what the
# version-pin rule everywhere in this estate expects.
ignore-scripts=true
save-exact=true
